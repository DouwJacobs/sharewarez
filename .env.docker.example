# Docker-specific application environment configuration
# Copy this file to .env when using Docker and customize the values

# Published GameLibrary image. Use douwjacobs/gamelibrary:v1 to stay on major version 1.
GAME_LIBRARY_IMAGE=douwjacobs/gamelibrary:latest

# Database connection - NOTE: Use 'db' as hostname for Docker Compose setup
DATABASE_URL=postgresql://postgres:postgres@db:5432/sharewarez

# Test database (only needed if running unit tests)
TEST_DATABASE_URL=postgresql://postgres:postgres@db:5432/sharewareztest

# Game storage directory - mounted as volume in docker-compose.yml
DATA_FOLDER_WAREZ=/storage

# Base folders (for path resolution)
BASE_FOLDER_WINDOWS=C:\
BASE_FOLDER_POSIX=/

# Flask secret key - CHANGE THIS to a secure random string
SECRET_KEY=put_your_own_secret_string_here_32617432

# Host path for persistent library storage (cover images, themes, zips)
# This is mounted into the container - use a path relative to docker-compose.yml
# Existing deployments must grant UID/GID 10001 ownership before upgrading.
LIBRARY_HOST_PATH=./data/library

# Validated PostgreSQL backups. The app creates a snapshot before schema
# upgrades and retains the newest ten archives by default.
BACKUP_HOST_PATH=./data/backups
BACKUP_BEFORE_UPGRADE=true
BACKUP_RETENTION_COUNT=10

# Development mode - set to true during theme development
DEV_MODE=false

# Number of Uvicorn application processes. Two supports concurrent users and
# streaming downloads without the memory cost of the previous four workers.
WEB_WORKERS=2

# Per-worker SQLAlchemy connection pool. With two workers these defaults allow
# four persistent and up to four temporary application connections.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=1800

# Docker-specific PostgreSQL configuration
# These variables are used by the postgres container in docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sharewarez

# Additional Docker configuration
# Database host for internal container communication
DATABASE_HOST=db
DATABASE_PORT=5432

# HTTP boundary security. Leave TRUST_PROXY_COUNT at 0 for direct access. Set
# it only when every request passes through that many trusted reverse proxies.
TRUST_PROXY_COUNT=0
# Optional comma-separated host allowlist, for example library.example.com.
TRUSTED_HOSTS=
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=300 per minute
SECURITY_HSTS_ENABLED=true

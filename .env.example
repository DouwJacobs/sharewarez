# for docker, replace localhost with db in the database_url
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sharewarez
# you only need to configure a test database if you plan to run the unit tests
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sharewareztest
# Point these to game folders, never the filesystem/drive root. Private torrent
# attachments and backups must be outside all configured game folders.
DATA_FOLDER_WAREZ=/storage
BASE_FOLDER_WINDOWS=C:\Games
BASE_FOLDER_POSIX=/storage
SECRET_KEY=put_your_own_secret_string_here_32617432
# this folder is where the app will store static files like cover images and themes
# for non-docker installs, this path is relative to where you run the app
# for docker installs, set LIBRARY_HOST_PATH in .env instead (see .env.docker.example)
UPLOAD_FOLDER=./sharewarez/static/library
# Private persistent attachments; never place this under the public static folder.
TORRENT_STORAGE_DIR=./instance/torrent_sources
# set to true during development to force theme files to be recopied on startup (helpful for theme development)
DEV_MODE=false
# port for the web server to run on (defaults to 5006 if not set)
PORT=5006
# Generic webhooks reject local and private-network targets by default. Enable
# this only when trusted administrators must call an internal automation service.
ALLOW_PRIVATE_WEBHOOK_TARGETS=false
# these are only used by the docker setup, you can ignore them if not using docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sharewarez
